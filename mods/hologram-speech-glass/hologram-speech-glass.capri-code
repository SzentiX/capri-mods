// capri-mod: 1
// id: hologram-speech-glass
// name: Hologram Speech Glass
// version: 0.1.4
// author: Dominik20074
// description: Makes Capri's speech bubble translucent in Hologram mode.
using System;
using System.Drawing;
using System.Collections.Generic;
using System.IO;
using System.Drawing.Imaging;
using System.Reflection;
using System.Runtime.InteropServices;
using System.Windows.Forms;
using CapriDesktop;

public sealed class HologramSpeechGlass : ICapriMod
{
    private const BindingFlags Members = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
    private ICapriHost host;
    private object owner;
    private Form bubble;
    private PropertyInfo hologramState, image;
    private Action<IntPtr, Bitmap, Point> draw;
    private Timer timer;
    private bool enabled = true;
    private Control frame, toggle, hologram, musicLight;
    private bool placingMusic;
    private PropertyInfo checkedProperty;
    private string settings;
    private readonly Dictionary<Control,int> shifted = new Dictionary<Control,int>();
    private List<KeyValuePair<Control,int>> pageRows;
    private Dictionary<Control,int> built, tops;
    private List<Control> scrolled;
    private MethodInfo closeGaps;
    private Bitmap last;
    private IntPtr lastHandle;
    private Point lastLocation;


    public void Start(ICapriHost capri)
    {
        host = capri;
        FieldInfo ownerField = capri.GetType().GetField("capri", Members);
        owner = ownerField == null ? null : ownerField.GetValue(capri);
        if (owner == null) throw new NotSupportedException("Capri mod host is incompatible.");
        Type type = owner.GetType();
        FieldInfo box = type.GetField("box", Members);
        bubble = box == null ? null : box.GetValue(owner) as Form;
        hologramState = type.GetProperty("HologramOn", Members);
        image = bubble == null ? null : bubble.GetType().GetProperty("Image", Members);
        Type native = type.Assembly.GetType("CapriDesktop.Native", false);
        MethodInfo render = native == null ? null : native.GetMethod("DrawLayered",
            BindingFlags.Static | BindingFlags.NonPublic, null,
            new[] { typeof(IntPtr), typeof(Bitmap), typeof(Point) }, null);
        if (bubble == null || hologramState == null || image == null || render == null)
            throw new NotSupportedException("Capri speech bubble interface is incompatible.");
        draw = (Action<IntPtr, Bitmap, Point>)Delegate.CreateDelegate(typeof(Action<IntPtr, Bitmap, Point>), render);
        settings = Path.Combine(host.Folder, "enabled.txt");
        if (File.Exists(settings)) enabled = File.ReadAllText(settings).Trim() != "off";
        AddToggle();
        Application.Idle += Tick;
        timer = new Timer { Interval = 10 };
        timer.Tick += Tick;
        timer.Start();
    }

    [DllImport("dwmapi.dll")]
    private static extern int DwmSetWindowAttribute(IntPtr window, int attribute, ref int value, int size);

    private Mirror mirror;

    private void Restore()
    {
        if (lastHandle != IntPtr.Zero)
        {
            int off = 0;
            DwmSetWindowAttribute(lastHandle, 13, ref off, 4);
            lastHandle = IntPtr.Zero;
        }
        if (mirror != null) mirror.Hide();
        last = null;
    }

    private void Tick(object sender, EventArgs args)
    {
        try
        {
            SyncToggle();
            if (!enabled || bubble.IsDisposed || !bubble.Visible || !bubble.IsHandleCreated ||
                !(bool)hologramState.GetValue(owner, null))
            {
                Restore();
                return;
            }
            Bitmap original = image.GetValue(bubble, null) as Bitmap;
            if (original == null) return;
            IntPtr handle = bubble.Handle;
            Point at = bubble.Location;
            if (last == original && lastHandle == handle && lastLocation == at) return;
            if (lastHandle != handle)
            {
                Restore();
                int on = 1;
                Marshal.ThrowExceptionForHR(DwmSetWindowAttribute(handle, 13, ref on, 4));
                lastHandle = handle;
            }
            if (mirror == null) mirror = new Mirror();
            mirror.Bounds = new Rectangle(at, original.Size);
            using (Bitmap translucent = new Bitmap(original.Width, original.Height, PixelFormat.Format32bppPArgb))
            using (Graphics graphics = Graphics.FromImage(translucent))
            using (ImageAttributes attributes = new ImageAttributes())
            {
                attributes.SetColorMatrix(new ColorMatrix { Matrix33 = 0.63f });
                graphics.DrawImage(original, new Rectangle(Point.Empty, original.Size), 0, 0,
                    original.Width, original.Height, GraphicsUnit.Pixel, attributes);
                draw(mirror.Handle, translucent, at);
            }
            if (!mirror.Visible) mirror.Show();
            last = original;
            lastLocation = at;
        }
        catch (Exception error)
        {
            Stop();
            host.Log("Hologram Speech Glass stopped: " + error.GetBaseException().Message);
        }
    }

    public bool Heard(string words) { return false; }

    private void Enable(bool value)
    {
        enabled = value;
        if (toggle != null && (bool)checkedProperty.GetValue(toggle, null) != value)
            checkedProperty.SetValue(toggle, value, null);
        try { File.WriteAllText(settings, value ? "on" : "off"); }
        catch (IOException error) { host.Log("Speech Glass settings: " + error.Message); }
        catch (UnauthorizedAccessException error) { host.Log("Speech Glass settings: " + error.Message); }
    }

    private void AddToggle()
    {
        FieldInfo mainframe = owner.GetType().GetField("mainframe", Members);
        frame = mainframe == null ? null : mainframe.GetValue(owner) as Control;
        if (frame == null) return;
        Type type = frame.GetType();
        FieldInfo anchor = type.GetField("hologram", Members);
        hologram = anchor == null ? null : anchor.GetValue(frame) as Control;
        MethodInfo make = type.GetMethod("Switch", Members, null,
            new[] { typeof(string), typeof(int), typeof(int), typeof(EventHandler) }, null);
        if (hologram == null || make == null) return;
        pageRows = type.GetField("pageLeft", Members).GetValue(frame) as List<KeyValuePair<Control,int>>;
        built = type.GetField("built", Members).GetValue(frame) as Dictionary<Control,int>;
        tops = type.GetField("tops", Members).GetValue(frame) as Dictionary<Control,int>;
        scrolled = type.GetField("scrolled", Members).GetValue(frame) as List<Control>;
        closeGaps = type.GetMethod("CloseGaps", Members);
        int anchorTop;
        if (pageRows == null || built == null || tops == null || scrolled == null ||
            closeGaps == null || !built.TryGetValue(hologram, out anchorTop)) return;
        int left = pageRows.Find(entry => entry.Key == hologram).Value;
        EventHandler change = delegate { if (toggle != null) Enable((bool)checkedProperty.GetValue(toggle, null)); };
        toggle = make.Invoke(frame, new object[] { "Speech Glass", left - 28, anchorTop + 25, change }) as Control;
        if (toggle == null) return;
        checkedProperty = toggle.GetType().GetProperty("Checked", Members);
        if (checkedProperty == null) { toggle.Dispose(); toggle = null; return; }

        int column = (int)type.GetField("Column", BindingFlags.Static | BindingFlags.NonPublic).GetRawConstantValue();
        foreach (KeyValuePair<Control,int> entry in pageRows)
        {
            int y;
            if (entry.Value < column || !built.TryGetValue(entry.Key, out y) || y <= anchorTop) continue;
            shifted.Add(entry.Key, y);
            built[entry.Key] = y + 28;
        }
        pageRows.Add(new KeyValuePair<Control,int>(toggle, left));
        built[toggle] = anchorTop + 28;
        tops[toggle] = hologram.Top + 28;
        MethodInfo scroll = type.GetMethod("Scrolls", Members);
        if (scroll != null) scroll.Invoke(frame, new object[] { toggle });
        else scrolled.Add(toggle);
        checkedProperty.SetValue(toggle, enabled, null);
        closeGaps.Invoke(frame, null);
        SyncToggle();
    }

    private void SyncToggle()
    {
        if (toggle == null || toggle.IsDisposed || hologram.IsDisposed) return;
        int step = (int)Math.Round(hologram.Height * 28.0 / 22);
        toggle.SetBounds(hologram.Left, hologram.Top + step, hologram.Width, hologram.Height);
        toggle.Font = hologram.Font;
        toggle.Visible = hologram.Visible;
        toggle.TabStop = hologram.TabStop;
        Control light = pageRows.Find(entry => entry.Key.Text == "Music Light").Key;
        if (light != musicLight)
        {
            if (musicLight != null) musicLight.LocationChanged -= PlaceMusicLight;
            musicLight = light;
            if (musicLight != null) musicLight.LocationChanged += PlaceMusicLight;
        }
        PlaceMusicLight(null, EventArgs.Empty);
    }

    private void PlaceMusicLight(object sender, EventArgs args)
    {
        if (placingMusic || toggle == null || musicLight == null || musicLight.IsDisposed) return;
        placingMusic = true;
        try
        {
            int step = toggle.Top - hologram.Top;
            int top = toggle.Top + step;
            if (musicLight.Top != top) musicLight.Top = top;
        }
        finally { placingMusic = false; }
    }

    private void RemoveToggle()
    {
        if (toggle == null) return;
        if (musicLight != null) { musicLight.LocationChanged -= PlaceMusicLight; musicLight = null; }
        pageRows.RemoveAll(entry => entry.Key == toggle);
        built.Remove(toggle);
        tops.Remove(toggle);
        scrolled.Remove(toggle);
        foreach (Control row in shifted.Keys)
            if (built.ContainsKey(row)) built[row] -= 28;
        shifted.Clear();
        toggle.Dispose();
        toggle = null;
        if (!frame.IsDisposed) closeGaps.Invoke(frame, null);
    }

    public void Stop()
    {
        Application.Idle -= Tick;
        RemoveToggle();
        if (timer != null) { timer.Stop(); timer.Tick -= Tick; timer.Dispose(); timer = null; }
        Restore();
        if (mirror != null) { mirror.Dispose(); mirror = null; }
    }

    private sealed class Mirror : Form
    {
        internal Mirror()
        {
            FormBorderStyle = FormBorderStyle.None;
            ShowInTaskbar = false;
            StartPosition = FormStartPosition.Manual;
            AutoScaleMode = AutoScaleMode.None;
            TopMost = true;
        }
        protected override bool ShowWithoutActivation { get { return true; } }
        protected override CreateParams CreateParams
        {
            get
            {
                CreateParams style = base.CreateParams;
                style.ExStyle |= 0x00080000 | 0x08000000 | 0x00000080 | 0x20;
                return style;
            }
        }
    }
}
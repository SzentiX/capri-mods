oke(Owner,new object[]{target.ReactionNativeText});}catch(Exception error){SafeLog("Reaction fallback: "+error.Message);}}private static bool AllowedReaction(CaprichatEmoji e,string[]banned,string[]fav){return e!=null&&CaprichatEmojiArt.HasArt(e)&&(!banned.Contains(e.Glyph)||(MK002Settings.favOverrideBlacklist&&fav.Contains(e.Glyph)));}private static CaprichatEmoji BackupReaction(string text,string[]banned,string[]fav){string[]pool=Regex.IsMatch(text??"",@"(?i)\b(hurt|kill|hospital|hate|dead|threat)\b")?new[]{"😡","😒","🙄","😬","😐","🤨","😠","😤"}:new[]{"🤔","😅","👀","🙃","😮","😏","🥹","😎","😂","💀","🔥","❤️","👍","😌","🙄"};int start=((text??"").GetHashCode()&int.MaxValue)%pool.Length;for(int i=0;i<pool.Length;i++){CaprichatEmoji e=CaprichatEmoji.Resolve(pool[(start+i)%pool.Length]);if(AllowedReaction(e,banned,fav))return e;}return null;}private void RunNextReaction(){Tuple<CaprichatMessage,string,string>next;lock(reactionGate){if(stopped||reactionQueue.Count==0){reactionBusy=0;return;}next=reactionQueue.Dequeue();}CaprichatMessage target=next.Item1;string userEmoji=next.Item2,context=next.Item3;ThreadPool.QueueUserWorkItem(delegate{try{if(userEmoji!=null){string prompt="As Capri, reply naturally to the user's emoji in one text-only sentence.";string reply=CleanAiMessage(AskCapri(prompt,context,MK002Settings.EmojiReplyModelTokenLimit));if(reply.Length==0||EmojiOnlyReply(reply))return;OnUI(delegate{if(stopped||!Messages.Any(x=>x.Id==target.Id))return;List<CaprichatReaction>list;if(Reactions.TryGetValue(target.Id,out list)&&list.Any(x=>!x.Capri&&x.Glyph==userEmoji))SpeakThenShow(reply,"caprichat-emoji-reply");});return;}bool alsoReply=target.ReactionOwnsReply&&Roll(MK002Settings.CapriRepliesAfterReactingPercent);string[]favorites=(MK002Settings.FavoriteReactionEmojis??"").Split(',').Select(x=>CaprichatEmoji.Resolve(x.Trim())).Where(x=>x!=null).Select(x=>x.Glyph).Distinct().ToArray();string[]blocked;string previous;lock(reactionGate){previous=lastCapriReaction;blocked=recentCapriReactions.Take(Math.Max(0,Math.Min(48,MK002Settings.ReactionBlacklistRecentCount))).ToArray();}string promptReaction="As Capri, use a fitting emoji. Two lines: EMOJI: :name: then REASON: why.";if(blocked.Length>0)promptReaction+=" Never reuse: "+string.Join(",",blocked.Select(CaprichatEmoji.ModelAlias).ToArray())+".";else if(previous.Length>0&&!Roll(MK002Settings.LastReactionRepeatChancePercent))promptReaction+=" Avoid repeating "+CaprichatEmoji.ModelAlias(previous)+" when fitting.";if(favorites.Length>0&&Roll(MK002Settings.FavoriteReactionBoostPercent))promptReaction+=" Favorite emojis: "+string.Join(",",favorites.Select(CaprichatEmoji.ModelAlias).ToArray())+" (only if fitting).";if(alsoReply)promptReaction+=" Add REPLY: one brief text-only sentence.";string result=AskCapri(promptReaction,context,alsoReply?Math.Max(100,MK002Settings.ReactionModelTokenLimit+65):MK002Settings.ReactionModelTokenLimit);CaprichatEmoji item=ParseEmotion(result);if(!AllowedReaction(item,blocked,favorites))item=BackupReaction(target.Text,blocked,favorites);if(item==null){if(target.ReactionOwnsReply)OnUI(delegate{FallbackReactionReply(target);});return;}if(item!=null&&!favorites.Contains(item.Glyph)&&Roll(MK002Settings.FavoriteReactionBoostPercent)){string e=item.Glyph;foreach(string f in favorites){bool fit=f=="🔥"&&"😎🤩👏👍🚀🎉💯😮🔥".Contains(e)||f=="❤️"&&"🥰😍😘💕❤️💖".Contains(e)||f=="😂"&&"🤣😆😅😂".Contains(e);if(fit&&AllowedReaction(CaprichatEmoji.Resolve(f),blocked,favorites)){item=CaprichatEmoji.Resolve(f);break;}}}string reason=Extract(result,"REASON");if(string.IsNullOrWhiteSpace(reason))reason="Reacting to "+ShortText(target.Text,90);string replyText=alsoReply?CleanAiMessage(Extract(result,"REPLY")):"";string finalReason=ShortText(reason,150),finalReply=replyText;CaprichatEmoji chosen=item;lock(reactionGate){recentCapriReactions.Remove(chosen.Glyph);recentCapriReactions.Insert(0,chosen.Glyph);if(recentCapriReactions.Count>48)recentCapriReactions.RemoveRange(48,recentCapriReactions.Count-48);lastCapriReaction=chosen.Glyph;}OnUI(delegate{if(stopped||!Messages.Any(x=>x.Id==target.Id))return;List<CaprichatReaction>list;if(!Reactions.TryGetValue(target.Id,out list))Reactions[target.Id]=list=new List<CaprichatReaction>();if(!list.Any(x=>x.Capri&&x.Glyph==chosen.Glyph)){list.Add(new CaprichatReaction{Glyph=chosen.Glyph,Capri=true,Reason=finalReason});}SaveState();Updated();bool hasReply=alsoReply&&finalReply.Length>0&&!EmojiOnlyReply(finalReply);if(target.ReactionOwnsReply){if(!alsoReply||hasReply)NativeTranscript("You",CaprichatEmoji.ToModelText(target.Text.StartsWith("↪ ",StringComparison.Ordinal)&&target.Text.IndexOf('\n')>=0?target.Text.Substring(target.Text.IndexOf('\n')+1):target.Text));RememberReactionTurn(target,hasReply?finalReply:null);}if(hasReply)SpeakThenShow(finalReply,"caprichat-reaction-followup");else if(alsoReply&&target.ReactionOwnsReply)FallbackReactionReply(target);});}catch(Exception error){ReactionProblem(error.Message);}finally{RunNextReaction();}});}private static string Extract(string raw,string name){Match m=Regex.Match(raw??"","(?im)^"+name+@":\s*([^\r\n]+)");return m.Success?m.Groups[1].Value.Trim():"";}private static CaprichatEmoji ParseEmotion(string raw){if(string.IsNullOrWhiteSpace(raw))return null;CaprichatEmoji chosen=CaprichatEmoji.Resolve(Extract(raw,"EMOJI"));if(chosen!=null)return chosen;Match alias=Regex.Match(raw,@":[a-zA-Z0-9_+\-]+:");if(alias.Success){chosen=CaprichatEmoji.Resolve(alias.Value);if(chosen!=null)return chosen;}foreach(CaprichatEmoji e in CaprichatEmoji.All)if(raw.Contains(e.Glyph))return e;return CaprichatEmoji.Resolve(raw.Trim().Trim('"',' ','.','!'));}private string AskCapri(string system,string user,int limit){if(Brain==null)return null;try{Type type=Brain.GetType();PropertyInfo persona=type.GetProperty("Character",BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static);string character=persona==null?"":persona.GetValue(null,null)as string;MethodInfo method=type.GetMethods(flags).FirstOrDefault(m=>m.Name=="Aside"&&m.GetParameters().Length==4);if(method==null)return null;return method.Invoke(Brain,new object[]{character+"\n"+system,user,limit,false})as string;}catch(TargetInvocationException error){SafeLog("AI: "+(error.InnerException??error).Message);return null;}catch(Exception error){SafeLog("AI: "+error.Message);return null;}}private static string Enc(string value){return Convert.ToBase64String(Encoding.UTF8.GetBytes(value??""));}private static string Dec(string value){try{return Encoding.UTF8.GetString(Convert.FromBase64String(value));}catch(FormatException){return"";}}private void LoadState(){string path=Path.Combine(Folder,"messages.tsv");try{if(File.Exists(path))foreach(string line in File.ReadAllLines(path,Encoding.UTF8)){string[]col=line.Split('\t');long ticks;if((col.Length!=5&&col.Length!=6)||!long.TryParse(col[1],out ticks)||ticks<DateTime.MinValue.Ticks||ticks>DateTime.MaxValue.Ticks)continue;CaprichatMessage stored=new CaprichatMessage{Id=col[0],At=new DateTime(ticks),User=col[2]=="1",Source=col[3],Text=Dec(col[4]),Attachments=col.Length==6?Dec(col[5]):""};if(stored.IsNotice)stored.User=false;Messages.Add(stored);if(col[3]=="transcript")seenTranscript.Add(col[0]);}}catch(Exception error){SafeLog("Read messages: "+error.Message);}if(Messages.Count>1500)Messages.RemoveRange(0,Messages.Count-1500);path=Path.Combine(Folder,"reactions.tsv");try{if(File.Exists(path))foreach(string line in File.ReadAllLines(path,Encoding.UTF8)){string[]col=line.Split('\t');if(col.Length!=4)continue;List<CaprichatReaction>list;if(!Reactions.TryGetValue(col[0],out list))Reactions[col[0]]=list=new List<CaprichatReaction>();list.Add(new CaprichatReaction{Capri=col[1]=="1",Glyph=Dec(col[2]),Reason=Dec(col[3])});}}catch(Exception error){SafeLog("Read reactions: "+error.Message);}path=Path.Combine(Folder,"last-capri-reaction.txt");try{if(File.Exists(path)){foreach(string glyph in File.ReadAllLines(path,Encoding.UTF8).Select(x=>x.Trim()).Where(x=>x.Length>0).Take(48))if(!recentCapriReactions.Contains(glyph))recentCapriReactions.Add(glyph);if(recentCapriReactions.Count>0)lastCapriReaction=recentCapriReactions[0];}}catch(Exception error){SafeLog("Read recent reactions: "+error.Message);}path=Path.Combine(Folder,"recent-emojis.txt");try{if(File.Exists(path))Recent.AddRange(File.ReadAllLines(path,Encoding.UTF8).Where(x=>x.Length>0).Take(MK002Settings.RecentEmojiCount));}catch(Exception error){SafeLog("Read recents: "+error.Message);}path=Path.Combine(Folder,"stars.tsv");try{if(File.Exists(path))foreach(string line in File.ReadAllLines(path,Encoding.UTF8)){string[]parts=line.Split('\t');int bits;if(parts.Length==2&&int.TryParse(parts[1],out bits)&&bits>0&&bits<=3)Stars[parts[0]]=bits;}}catch(Exception error){SafeLog("Read stars: "+error.Message);}path=Path.Combine(Folder,"star-review.txt");try{if(File.Exists(path)){string[]lines=File.ReadAllLines(path,Encoding.UTF8);int count;if(lines.Length>0&&int.TryParse(lines[0],out count))promptsSinceReview=Math.Max(0,Math.Min(9,count));promptIds.AddRange(lines.Skip(1).Where(id=>Messages.Any(m=>m.Id==id)).Take(9));}}catch(Exception error){SafeLog("Read star review: "+error.Message);}}internal void SaveState(){if(Folder==null||stateLoading)return;try{lock(saving){WriteSafe(Path.Combine(Folder,"messages.tsv"),Messages.Where(x=>x.Source!="transcript").Reverse().Take(1500).Reverse().Select(x=>x.Id+"\t"+x.At.Ticks+"\t"+(x.User?"1":"0")+"\t"+x.Source+"\t"+Enc(x.Text)+"\t"+Enc(x.Attachments)).ToArray());WriteSafe(Path.Combine(Folder,"reactions.tsv"),Reactions.SelectMany(k=>k.Value.Select(v=>k.Key+"\t"+(v.Capri?"1":"0")+"\t"+Enc(v.Glyph)+"\t"+Enc(v.Reason))).ToArray());WriteSafe(Path.Combine(Folder,"last-capri-reaction.txt"),recentCapriReactions.ToArray());WriteSafe(Path.Combine(Folder,"recent-emojis.txt"),Recent.ToArray());WriteSafe(Path.Combine(Folder,"stars.tsv"),Stars.Select(x=>x.Key+"\t"+x.Value).ToArray());WriteSafe(Path.Combine(Folder,"star-review.txt"),(new[]{promptsSinceReview.ToString()}).Concat(promptIds).ToArray());}}catch(Exception error){SafeLog("Save: "+error.Message);}}private static void WriteSafe(string path,string[]rows){string next=path+".new";File.WriteAllLines(next,rows,new UTF8Encoding(false));if(File.Exists(path)){try{File.Replace(next,path,path+".bak");return;}catch(IOException){File.Copy(next,path,true);File.Delete(next);return;}catch(PlatformNotSupportedException){File.Copy(next,path,true);File.Delete(next);return;}}File.Move(next,path);}}internal static class ChatEnumerable{internal static IEnumerable<T>TakeLastCompat<T>(this IEnumerable<T>source,int count){return source.Reverse().Take(count).Reverse();}}internal sealed class CaprichatMessage{internal bool SpeechPending,SpeechObserved;internal DateTime SpeechRequested;internal string Id,Text,Source,Attachments;internal bool ReactionOwnsReply;internal string ReactionNativeText;internal DateTime At;internal bool User;internal bool IsObservation{get{return Regex.IsMatch((Text??"").TrimStart(' ','*','\t'),@"^(?:\d{2}:\d{2}\s+)?(?:\(?You (?:glanced|looked) at their screen|She (?:glanced|looked) at your screen|She thought about |Screen observation\b|Background research record:|She remembers that:)",RegexOptions.IgnoreCase);}}internal bool IsActivity{get{return Regex.IsMatch((Text??"").TrimStart(' ','*','\t'),@"^(?:\d{2}:\d{2}\s+)?(?:Job\s*:|Job completed\s*:|Activity\s*:|Tool finished\s*:)",RegexOptions.IgnoreCase);}}internal bool IsNotice{get{return IsObservation||IsActivity;}}}internal sealed class CaprichatReaction{internal string Glyph,Reason;internal bool Capri;}internal static class ChatColors{internal static readonly Color Ground=Color.FromArgb(10,10,16),Rose=Color.FromArgb(255,93,102),Cyan=Color.FromArgb(94,240,246),White=Color.FromArgb(236,236,241),Faint=Color.FromArgb(146,130,140),Field=Color.FromArgb(17,16,28),Hot=Color.FromArgb(232,66,70),Blue=Color.FromArgb(73,163,255),Well=Color.FromArgb(9,30,33),Edge=Color.FromArgb(92,24,36);private static readonly Dictionary<string,Font>fonts=new Dictionar
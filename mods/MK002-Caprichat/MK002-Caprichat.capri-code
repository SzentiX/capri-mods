}public sealed class MK002Caprichat:ICapriMod{internal ICapriHost Host;internal Control Owner;internal object Brain;internal CaprichatWindow Window;internal string Folder;internal float FontSize=MK002Settings.MessageFontSize;internal bool HideObservations=MK002Settings.HideObservationsByDefault;internal bool HideJobs=MK002Settings.HideJobsByDefault;internal void SetNoticeVisibility(bool observations,bool jobs){HideObservations=observations;HideJobs=jobs;try{File.WriteAllLines(Path.Combine(Folder,"notice-visibility.txt"),new[]{observations.ToString(),jobs.ToString()});}catch(IOException){}catch(UnauthorizedAccessException){}if(Window!=null&&!Window.IsDisposed)Window.RefreshChat();}internal readonly List<CaprichatMessage>Messages=new List<CaprichatMessage>();internal readonly Dictionary<string,List<CaprichatReaction>>Reactions=new Dictionary<string,List<CaprichatReaction>>();internal readonly List<string>Recent=new List<string>();private readonly List<CaprichatMessage>speechQueue=new List<CaprichatMessage>();internal readonly Dictionary<string,int>Stars=new Dictionary<string,int>();private readonly List<string>promptIds=new List<string>();private int promptsSinceReview;private readonly Dictionary<string,DateTime>checks=new Dictionary<string,DateTime>();private readonly Dictionary<string,long>transcriptLengths=new Dictionary<string,long>();private readonly HashSet<string>seenTranscript=new HashSet<string>();private System.Windows.Forms.Timer timer;private int reactionBusy;private readonly object reactionGate=new object();private string lastCapriReaction="";private readonly List<string>recentCapriReactions=new List<string>();private readonly Queue<Tuple<CaprichatMessage,string,string>>reactionQueue=new Queue<Tuple<CaprichatMessage,string,string>>();private volatile bool stopped;private bool bootstrapping;private string status="LOCAL ARCHIVE · CONNECTED";private readonly Random random=new Random();private readonly object saving=new object();private readonly BindingFlags flags=BindingFlags.Instance|BindingFlags.Public|BindingFlags.NonPublic;private volatile bool stateLoading,transcriptLoading;internal bool ArchiveIsLoading{get{return stateLoading||transcriptLoading;}}internal int LoadedArchiveMessages,TotalArchiveMessages=1;private DateTime lastArchiveSurveyUtc=DateTime.MinValue;public void Start(ICapriHost capri){Host=capri;Folder=capri.Folder;stopped=false;FontSize=MK002Settings.MessageFontSize;HideObservations=MK002Settings.HideObservationsByDefault;HideJobs=MK002Settings.HideJobsByDefault;try{string p=Path.Combine(Folder,"notice-visibility.txt");if(File.Exists(p)){string[]lines=File.ReadAllLines(p);bool on;if(lines.Length>0&&bool.TryParse(lines[0],out on))HideObservations=on;if(lines.Length>1&&bool.TryParse(lines[1],out on))HideJobs=on;}}catch(IOException){}catch(UnauthorizedAccessException){}try{string marker=Path.Combine(Folder,"notice-defaults-206.txt");if(!File.Exists(marker)){HideObservations=true;HideJobs=true;File.WriteAllLines(Path.Combine(Folder,"notice-visibility.txt"),new[]{"True","True"});File.WriteAllText(marker,"1");}}catch(IOException){}catch(UnauthorizedAccessException){}try{string p=Path.Combine(Folder,"chat-font-size.txt");float v;if(File.Exists(p)&&float.TryParse(File.ReadAllText(p),NumberStyles.Float,CultureInfo.InvariantCulture,out v))FontSize=Math.Max(6f,Math.Min(30f,v));}catch(Exception){}Messages.Clear();nativeReplyKeys.Clear();Reactions.Clear();Recent.Clear();Stars.Clear();speechQueue.Clear();lastCapriReaction="";recentCapriReactions.Clear();promptIds.Clear();promptsSinceReview=0;checks.Clear();transcriptLengths.Clear();seenTranscript.Clear();lastHistory="";recentReplyPrompts.Clear();try{string choice=Path.Combine(Folder,"chat-font.txt");string stored=File.Exists(choice)?File.ReadAllText(choice).Trim():MK002Settings.FontFilePath;ChatColors.SelectFont(stored);}catch(Exception){ChatColors.SelectFont(MK002Settings.FontFilePath);}lock(reactionGate){reactionQueue.Clear();reactionBusy=0;}FieldInfo field=capri.GetType().GetField("capri",flags);Owner=field==null?null:field.GetValue(capri)as Control;if(Owner==null)throw new InvalidOperationException("Capri host missing.");field=Owner.GetType().GetField("brain",flags);Brain=field==null?null:field.GetValue(Owner);stateLoading=true;transcriptLoading=true;timer=new System.Windows.Forms.Timer{Interval=2200};timer.Tick+=delegate{if(stopped)return;try{if(!stateLoading)CheckHistory(false);if(!transcriptLoading)CheckTranscripts(false);PollSpeech();}catch(Exception error){SafeLog("Sync: "+error.Message);}};timer.Start();ThreadPool.QueueUserWorkItem(delegate{BootstrapArchive();});capri.Log("MK002 v2.1.11 loaded.");}private bool DispatchArchive(Action action){if(stopped||Owner==null)return false;for(int i=0;i<600&&!stopped&&!Owner.IsDisposed&&!Owner.IsHandleCreated;i++)Thread.Sleep(100);if(stopped||Owner.IsDisposed||!Owner.IsHandleCreated)return false;using(ManualResetEvent done=new ManualResetEvent(false)){try{Owner.BeginInvoke((Action)delegate{try{if(!stopped)action();}catch(Exception e){SafeLog("Archive UI: "+e.Message);}finally{try{done.Set();}catch(ObjectDisposedException){}}});while(!done.WaitOne(100)){if(stopped)return false;}}catch(Exception e){SafeLog("Archive dispatch: "+e.Message);return false;}}return!stopped;}private void ArchiveProgress(int done,int total){LoadedArchiveMessages=Math.Max(0,done);TotalArchiveMessages=Math.Max(1,total);if(Window!=null&&!Window.IsDisposed)Window.SetArchiveProgress(LoadedArchiveMessages,TotalArchiveMessages,transcriptLoading);}private void BootstrapArchive(){try{MK002Caprichat staging=new MK002Caprichat{Folder=Folder};staging.bootstrapping=true;staging.LoadState();string root=Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),"Capri","transcripts");string[]files=Directory.Exists(root)?Directory.GetFiles(root,"????-??-??.md").OrderByDescending(x=>x).ToArray():new string[0];if(MK002Settings.StartupTranscriptDateLimit>0)files=files.Take(MK002Settings.StartupTranscriptDateLimit).ToArray();MK002Caprichat dayStage=new MK002Caprichat{Folder=Folder};dayStage.bootstrapping=true;if(files.Length>0)dayStage.CheckTranscriptFile(files[0],true);CaprichatMessage[]saved=staging.Messages.ToArray();CaprichatMessage[]firstDay=dayStage.Messages.ToArray();int total=saved.Length+firstDay.Length;foreach(string file in files.Skip(1))try{total+=File.ReadLines(file).Count(line=>line.StartsWith("**")||line.StartsWith("*"));}catch(IOException){}catch(UnauthorizedAccessException){}HashSet<string>initialIds=new HashSet<string>();CaprichatMessage[]initial=saved.Concat(firstDay).OrderByDescending(m=>m.At).Where(m=>initialIds.Add(m.Id)).Take(Math.Max(1,MK002Settings.StartupRecentMessages)).ToArray();int applied=initial.Length;int totalCount=Math.Max(applied,total);TotalArchiveMessages=totalCount;LoadedArchiveMessages=0;if(!DispatchArchive(delegate{foreach(KeyValuePair<string,List<CaprichatReaction>>pair in staging.Reactions)if(!Reactions.ContainsKey(pair.Key))Reactions[pair.Key]=pair.Value;foreach(KeyValuePair<string,int>pair in staging.Stars){int old;Stars.TryGetValue(pair.Key,out old);Stars[pair.Key]=old|pair.Value;}foreach(string em in staging.Recent)if(!Recent.Contains(em))Recent.Add(em);foreach(string em in staging.recentCapriReactions)if(!recentCapriReactions.Contains(em))recentCapriReactions.Add(em);if(recentCapriReactions.Count>0)lastCapriReaction=recentCapriReactions[0];promptsSinceReview=Math.Max(promptsSinceReview,staging.promptsSinceReview);foreach(string id in staging.promptIds)if(!promptIds.Contains(id))promptIds.Add(id);CaprichatEmojiArt.SetFolder(Folder);bootstrapping=true;foreach(CaprichatMessage m in saved)if(!m.User&&m.Source.StartsWith("caprichat-",StringComparison.Ordinal))nativeReplyKeys.Add(NativeReplyKey(m));try{foreach(CaprichatMessage m in initial.OrderBy(x=>x.At)){if(m.Source=="transcript")seenTranscript.Add(m.Id);Add(m);}CheckHistory(true);}finally{bootstrapping=false;}stateLoading=false;ArchiveProgress(applied,totalCount);Updated();}))return;if(!ImportArchiveBatch(saved.Where(m=>!initialIds.Contains(m.Id)).OrderByDescending(m=>m.At).ToArray(),ref applied,totalCount,false))return;if(files.Length>0){if(!ImportArchiveBatch(firstDay.Where(m=>!initialIds.Contains(m.Id)).Reverse().ToArray(),ref applied,totalCount,true))return;DateTime stamp;long length;dayStage.checks.TryGetValue(files[0],out stamp);dayStage.transcriptLengths.TryGetValue(files[0],out length);if(!DispatchArchive(delegate{checks[files[0]]=stamp;transcriptLengths[files[0]]=length;}))return;}for(int f=1;f<files.Length&&!stopped;f++){dayStage.Messages.Clear();dayStage.CheckTranscriptFile(files[f],true);if(!ImportArchiveBatch(dayStage.Messages.AsEnumerable().Reverse().ToArray(),ref applied,totalCount,true))return;DateTime stamp;long length;dayStage.checks.TryGetValue(files[f],out stamp);dayStage.transcriptLengths.TryGetValue(files[f],out length);string name=files[f];if(!DispatchArchive(delegate{checks[name]=stamp;transcriptLengths[name]=length;}))return;}}catch(Exception e){SafeLog("Archive loading: "+e.Message);}finally{DispatchArchive(delegate{stateLoading=false;transcriptLoading=false;ArchiveProgress(TotalArchiveMessages,TotalArchiveMessages);Updated();});}}private bool ImportArchiveBatch(CaprichatMessage[]items,ref int applied,int total,bool transcript){int size=Math.Max(1,MK002Settings.StartupTranscriptBatchMessages);for(int i=0;i<items.Length;i+=size){if(stopped)return false;CaprichatMessage[]batch=items.Skip(i).Take(size).ToArray();applied+=batch.Length;int done=applied;bool redraw=i==0||i+batch.Length>=items.Length||(i+batch.Length)%200==0;if(!DispatchArchive(delegate{bootstrapping=true;try{foreach(CaprichatMessage msg in batch){if(transcript)seenTranscript.Add(msg.Id);Add(msg);}}finally{bootstrapping=false;}ArchiveProgress(done,total);if(redraw)Updated();}))return false;Thread.Sleep(20);}return true;}private void ImportAdditionalDates(string[]files){try{MK002Caprichat stage=new MK002Caprichat{Folder=Folder};stage.bootstrapping=true;int applied=0,total=0;foreach(string file in files)try{total+=File.ReadLines(file).Count(line=>line.StartsWith("**")||line.StartsWith("*"));}catch(IOException){}catch(UnauthorizedAccessException){}foreach(string file in files){if(stopped)return;stage.Messages.Clear();stage.CheckTranscriptFile(file,true);if(!ImportArchiveBatch(stage.Messages.AsEnumerable().Reverse().ToArray(),ref applied,Math.Max(1,total),true))return;DateTime stamp;long length;stage.checks.TryGetValue(file,out stamp);stage.transcriptLengths.TryGetValue(file,out length);if(!DispatchArchive(delegate{checks[file]=stamp;transcriptLengths[file]=length;}))return;}}catch(Exception e){SafeLog("Historical import: "+e.Message);}finally{DispatchArchive(delegate{transcriptLoading=false;ArchiveProgress(TotalArchiveMessages,TotalArchiveMessages);Updated();});}}public bool Heard(string words){if(stopped||!WantsOpen(words))return false;OnUI(delegate{Open();});ThreadPool.QueueUserWorkItem(delegate{string said=AskCapri("The user opened Caprichat. Reply naturally in character.","Their request: "+(words??""),100);if(stopped||string.IsNullOrWhiteSpace(said))return;OnUI(delegate{SpeakThenShow(said,"caprichat-opening");});});return true;}internal static bool WantsOpen(string input){if((input??"").StartsWith("Caprichat private chat reply.",StringComparison.Ordinal))return false;string s=Regex.Replace((input??"").ToLowerInvariant().Replace('’','\''),@"[^a-z0-9]+"," ").Trim();if(s=="caprichat"||s=="capri chat"||s=="our chat"||s=="your dm"||s=="our dms")return true;if(Regex.IsMatch(s,@"\b(don t|do not|never|stop|without|close|shut|why|how|what is|explain)\b"))return false;bool target=Regex.IsMatch(s,@"\b(caprichat|capri chat|our chat|your chat|my chat|our dms?|your dms?|my dms?|direct messages|our messages|your messages|the chat window|message window|our conversation|our texts|our inbox)\b");bool action=Regex.IsMatch(s,@"\b(open|show|launch|display|bring|pull|pop|start|view|see|switch|go|take|let|want|access|get|enter)\b");if(target&&action)return true;return Regex.IsMatch(s,@"^(?:hey |yo |capri |please |can we |could we |wanna |i want to )*(?:dm|chat|text) (?:me|with me|together|on caprichat)(?: please)?$");}public void Stop(){stopped=true;lock(reactionGate)reactionQueue.Clear();speechQueue.Clear();if(timer!=null){timer.Stop();timer.Dispose();timer=null;}try{if(Owner!=null&&Owner.IsHandleCreated&&!Owner.IsDisposed){Action close=delegate{if(Window!=null&&!Window.IsDisposed){Window.Close();Window.Dispose();}Window=null;};if(Owner.InvokeRequired)Owner.BeginInvoke(close);else close();}}catch(ObjectDisposedException){}catch(InvalidOperationException){}}private void SafeLog(string text){try{if(Host!=null)Host.Log(text);}catch(Exception){}}private void ReactionProblem(string reason){SafeLog("Reaction: "+reason);}private bool SpeechEnabled(){try{PropertyInfo prop=Owner.GetType().GetProperty("Speaking",flags);return prop==null||!(prop.GetValue(Owner,null)is bool)||(bool)prop.GetValue(Owner,null);}catch(Exception){return true;}}private bool SpeechBusy(){try{PropertyInfo prop=Owner.GetType().GetProperty("LineBusy",flags);return prop!=null&&Convert.ToBoolean(prop.GetValue(Owner,null));}catch(Exception){return false;}}private void NativeTranscript(string who,string text){try{MethodInfo write=Brain==null?null:Brain.GetType().GetMethod("Transcribe",BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic,null,new[]{typeof(string),typeof(string),typeof(bool)},null);if(write==null){SafeLog("Native transcript writer not found");return;}write.Invoke(null,new object[]{who,text,true});}catch(Exception error){SafeLog("Native transcript: "+error.Message);}}internal void SpeakThenShow(string reply,string source){reply=TextOnlyCapri(reply);if(stopped||string.IsNullOrWhiteSpace(reply))return;CaprichatMessage m=new CaprichatMessage{Id=NewId(),At=DateTime.Now,User=false,Text=reply,Source=source};if(SpeechEnabled()){m.SpeechPending=true;m.SpeechRequested=DateTime.UtcNow;speechQueue.Add(m);}try{Host.Say(reply);}catch(Exception error){SafeLog("Speech: "+error.Message);m.SpeechPending=false;speechQueue.Remove(m);}NativeTranscript("Capri",reply);Add(m);}private void PollSpeech(){if(speechQueue.Count==0)return;bool busy=SpeechBusy(),enabled=SpeechEnabled(),changed=false;DateTime now=DateTime.UtcNow;foreach(CaprichatMessage m in speechQueue.ToArray()){double elapsed=(now-m.SpeechRequested).TotalSeconds;if(busy)m.SpeechObserved=true;if(!enabled||(!busy&&(m.SpeechObserved||elapsed>=6))||elapsed>=120){m.SpeechPending=false;speechQueue.Remove(m);changed=true;}}if(changed)Updated();}internal void OnUI(Action work){try{if(Owner==null||Owner.IsDisposed||!Owner.IsHandleCreated)return;Action safe=delegate{if(stopped||Owner==null||Owner.IsDisposed)return;try{work();}catch(Exception error){SafeLog("Chat UI: "+error.Message);}};if(Owner.InvokeRequired)Owner.BeginInvoke(safe);else safe();}catch(ObjectDisposedException){}catch(InvalidOperationException){}}internal void Open(){if(stopped)return;if(Window==null||Window.IsDisposed)Window=new CaprichatWindow(this);if(!Window.Visible)Window.Show();if(Window.WindowState==FormWindowState.Minimized)Window.WindowState=FormWindowState.Normal;Window.BringToFront();Window.Activate();Window.FocusCompose();}internal void ReopenWithFont(){if(Window!=null&&!Window.IsDisposed){Window.Close();Window.Dispose();}Window=null;Open();}internal bool Send(string words){return Send(words,new string[0],null);}internal bool Send(string words,string[]attachments){return Send(words,attachments,null);}internal bool Send(string words,string[]attachments,CaprichatMessage replyTo){words=(words??"").Replace("\u2003","").Trim();attachments=(attachments??new string[0]).Where(File.Exists).Distinct(StringComparer.OrdinalIgnoreCase).Take(8).ToArray();if((words.Length==0&&attachments.Length==0)||stopped)return false;string label=attachments.Length==0?"":string.Join(", ",attachments.Select(Path.GetFileName).ToArray());string display=(replyTo==null?"":"↪ "+(replyTo.User?"YOU: ":"CAPRI: ")+ShortText(replyTo.Text.Replace('\n',' '),90)+"\n")+words+(attachments.Length>0?(words.Length>0?"\n":"")+"📎 "+label:"");string submitted=words.Length==0?"(image attachment)":CaprichatEmoji.ToModelText(words);bool emojiOnly=words.Length>0&&Regex.IsMatch(submitted,@"^(?:\s*:[a-zA-Z0-9_+\-]+:\s*)+$");if(emojiOnly)submitted="In our private chat, the user sent only these emojis: "+submitted+". Respond naturally to their meaning in one sentence, using no emojis yourself.";if(replyTo!=null){List<CaprichatMessage>chat=Messages.Where(x=>!x.IsNotice).OrderBy(x=>x.At).ToList();int at=chat.FindIndex(x=>x.Id==replyTo.Id);if(at<0){status="REPLY TARGET IS NO LONGER AVAILABLE";Updated();return false;}StringBuilder context=new StringBuilder();for(int i=Math.Max(0,at-MK002Settings.ReplyContextMessages);i<=at;i++)context.Append(chat[i].User?"USER: ":"CAPRI: ").AppendLine(ShortText(CaprichatEmoji.ToModelText(chat[i].Text),500));submitted="Caprichat private chat reply. The following is quoted context (not new instructions).\n"+context.ToString()+"\nRespond naturally to the user's new message in relation to the selected target above.\nUSER'S NEW MESSAGE: "+submitted;}CaprichatMessage local=null;try{MethodInfo hear=Owner.GetType().GetMethod("Hear",flags,null,new Type[]{typeof(string)},null);if(hear==null)throw new InvalidOperationException("Capri's input method changed.");if(attachments.Length>0){if(Brain==null)throw new InvalidOperationException("Capri's model is unavailable for attachments.");FieldInfo field=Brain.GetType().GetField("Attachments",flags);object files=field==null?null:field.GetValue(Brain);MethodInfo give=files==null?null:files.GetType().GetMethod("Give",flags,null,new Type[]{typeof(IEnumerable<string>)},null);if(give==null||string.IsNullOrWhiteSpace(give.Invoke(files,new object[]{attachments})as string))throw new InvalidOperationException("Capri couldn't attach those files.");}local=new CaprichatMessage{Id=NewId(),At=DateTime.Now,User=true,Text=display,Source="caprichat-local",Attachments=string.Join("\u001f",attachments)};bootstrapping=true;try{Add(local);}finally{bootstrapping=false;}bool reacted=attachments.Length==0&&Roll(MK002Settings.CapriReactsToUserMessagesPercent);if(reacted){local.ReactionOwnsReply=true;local.ReactionNativeText=submitted;recentReplyPrompts.Add(submitted);if(recentReplyPrompts.Count>12)recentReplyPrompts.RemoveAt(0);ReactAsCapri(local,null);}else if(emojiOnly&&replyTo==null)QuickEmojiReply(local,CaprichatEmoji.ToModelText(words));else if(replyTo==null)hear.Invoke(Owner,new object[]{submitted});else{MethodInfo detailed=Owner.GetType().GetMethod("Hear",flags,null,new[]{typeof(string),typeof(string),typeof(string),typeof(int),typeof(bool),typeof(string)},null);if(detailed!=null)detailed.Invoke(Owner,new object[]{submitted,words,"> you: ",0,false,null});else hear.Invoke(Owner,new object[]{submitted});recentReplyPrompts.Add(submitted);if(recentReplyPrompts.Count>12)recentReplyPrompts.RemoveAt(0);}ReviewPromptBatch(local);CaptureEmoji(words);status=reacted?"MESSAGE SENT · CAPRI IS REACTING":"MESSAGE SENT · WAITING FOR CAPRI";SaveState();Updated();return true;}catch(Exception error){if(local!=null){Messages.Remove(local);SaveState();}Exception real=error is TargetInvocationException&&error.InnerException!=null?error.InnerException:error;status="SEND FAILED · "+real.Message;Updated();SafeLog(status);return false;}}private void QuickEmojiReply(CaprichatMessage target,string emojis){NativeTranscript("You",emojis);ThreadPool.QueueUserWorkItem(delegate{string reply=CleanAiMessage(AskCapri("You are Capri. Reply to these emojis in one short sentence, using no emojis.",emojis,MK002Settings.EmojiReplyModelTokenLimit));if(reply.Length==0)return;OnUI(delegate{if(stopped)return;target.ReactionNativeText=emojis;RememberReactionTurn(target,reply);SpeakThenShow(reply,"caprichat-emoji-only");});});}private readonly HashSet<string>nativeReplyKeys=new HashSet<string>();private static string NativeReplyKey(CaprichatMessage m){return m.At.ToString("yyyyMMddHHmm",CultureInfo.InvariantCulture)+"|"+m.Text;}private readonly List<string>recentReplyPrompts=new List<string>();internal string Status{get{return status;}}internal static string NewId(){return Guid.NewGuid().ToString("N").Substring(0,24);}internal void Add(CaprichatMessage message){if(message!=null&&!message.User&&!message.IsNotice)message.Text=TextOnlyCapri(message.Text);if(message==null||string.IsNullOrWhiteSpace(message.Text)||stopped)return;if(message.Source!="transcript"&&Messages.Any(x=>x.Id==message.Id))return;if(message.IsNotice)message.User=false;if(message.Source=="transcript"&&!message.User&&nativeReplyKeys.Contains(NativeReplyKey(message)))return;if(message.Source=="transcript"&&message.User&&Math.Abs((DateTime.Now-message.At).TotalMinutes)<=5&&Messages.Any(x=>x.User&&x.Source=="caprichat-local"&&Math.Abs((x.At-message.At).TotalMinutes)<=3&&SameNativeMessage(x,message.Text)))return;if(message.User&&(message.Source=="history"||message.Source=="transcript"||message.Source=="history-bootstrap")&&message.Text.StartsWith("Caprichat private chat reply.",StringComparison.Ordinal))return;if(message.Source=="history"&&Messages.Any(x=>x.User==message.User&&(DateTime.Now-x.At).TotalMinutes<4&&SameNativeMessage(x,message.Text)))return;if(message.User&&message.Source=="transcript"&&message.Text.StartsWith("↪ ",StringComparison.Ordinal)&&Messages.Any(x=>x.User&&x.Source=="caprichat-local"&&x.Text.StartsWith(message.Text,StringComparison.Ordinal)&&Math.Abs((x.At-message.At).TotalMinutes)<4))return;if(message.Source=="transcript"&&Math.Abs((DateTime.Now-message.At).TotalMinutes)<=5&&Messages.Any(x=>x.User==message.User&&x.Source=="history"&&(DateTime.Now-x.At).TotalMinutes<4&&SameNativeMessage(x,message.Text)))return;if(!bootstrapping&&!message.User&&!message.IsNotice&&(message.Source=="history"||message.Source=="transcript")&&(DateTime.Now-message.At).TotalMinutes<3&&SpeechEnabled()){message.SpeechPending=true;message.Spe
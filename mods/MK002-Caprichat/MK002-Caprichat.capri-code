ch.Groups[2].Value;if(speaker.Equals("Job",StringComparison.OrdinalIgnoreCase))transcriptText="Job: "+transcriptText;if(speaker.Equals("Activity",StringComparison.OrdinalIgnoreCase))transcriptText="Activity: "+transcriptText;if(speaker.Equals("Observation",StringComparison.OrdinalIgnoreCase))transcriptText="Screen observation: "+transcriptText;Add(new CaprichatMessage{Id=id,At=day.Add(time).AddTicks(i),User=speaker.Equals("You",StringComparison.OrdinalIgnoreCase),Text=transcriptText,Source="transcript"});}checks[file]=edited;transcriptLengths[file]=bytes;}}private string lastHistory="";private void CheckHistory(bool initial){if(Brain==null)return;try{FieldInfo field=Brain.GetType().GetField("history",flags);if(field==null)return;IList history=field.GetValue(Brain)as IList;if(history==null)return;List<string>keys=new List<string>();foreach(object line in history){FieldInfo role=line.GetType().GetField("Role",flags),content=line.GetType().GetField("Content",flags);if(role==null||content==null)continue;string who=role.GetValue(line)as string,txt=content.GetValue(line)as string;if(who!="user"&&who!="assistant")continue;if(string.IsNullOrWhiteSpace(txt))continue;keys.Add(who+"|"+txt);}string joined=string.Join("\u001f",keys.ToArray());if(initial){lastHistory=joined;foreach(string key in keys.TakeLastCompat(14)){int split=key.IndexOf('|');if(split<0)continue;string role=key.Substring(0,split),body=key.Substring(split+1);bool user=role=="user";if(Messages.Any(m=>m.User==user&&(DateTime.Now-m.At).TotalHours<6&&SameNativeMessage(m,body)))continue;Add(new CaprichatMessage{Id=NewId(),At=DateTime.Now,User=user,Text=body,Source="history-bootstrap"});}return;}if(joined==lastHistory)return;string[]prior=lastHistory.Length==0?new string[0]:lastHistory.Split('\u001f');int overlap=0;for(int n=Math.Min(prior.Length,keys.Count);n>=1;n--){bool same=true;for(int i=0;i<n;i++)if(prior[prior.Length-n+i]!=keys[i]){same=false;break;}if(same){overlap=n;break;}}int common=0;while(common<prior.Length&&common<keys.Count&&prior[common]==keys[common])common++;if(common==prior.Length&&prior.Length>overlap)overlap=prior.Length;for(int i=overlap;i<keys.Count;i++){int sep=keys[i].IndexOf('|');if(sep<0)continue;string who=keys[i].Substring(0,sep),txt=keys[i].Substring(sep+1);if(who=="user"&&recentReplyPrompts.Contains(txt))continue;bool appearsUser=who=="user"&&!(new CaprichatMessage{Text=txt}).IsNotice;if(Messages.Any(x=>x.User==appearsUser&&(DateTime.Now-x.At).TotalMinutes<4&&SameNativeMessage(x,txt)))continue;if(txt=="(image attachment)"&&Messages.Any(x=>x.Source=="caprichat-local"&&!string.IsNullOrEmpty(x.Attachments)&&(DateTime.Now-x.At).TotalMinutes<4))continue;Add(new CaprichatMessage{Id=NewId(),At=DateTime.Now,User=who=="user",Text=txt,Source="history"});}lastHistory=joined;}catch(Exception error){SafeLog("History: "+error.Message);}}internal void RememberEmoji(string emoji){if(string.IsNullOrEmpty(emoji))return;Recent.RemoveAll(x=>x==emoji);Recent.Insert(0,emoji);if(Recent.Count>MK002Settings.RecentEmojiCount)Recent.RemoveRange(MK002Settings.RecentEmojiCount,Recent.Count-MK002Settings.RecentEmojiCount);SaveState();}internal void CaptureEmoji(string text){if(string.IsNullOrEmpty(text)||!text.Any(c=>char.IsSurrogate(c)||c=='\ufe0f'||c=='\u20e3'||c>='\u2300'&&c<='\u3299'))return;string remaining=text;bool changed=false;foreach(CaprichatEmoji x in CaprichatEmoji.All.OrderByDescending(x=>x.Glyph.Length)){if(x.Glyph.Length==0||!remaining.Contains(x.Glyph))continue;remaining=remaining.Replace(x.Glyph,"");Recent.RemoveAll(r=>r==x.Glyph);Recent.Insert(0,x.Glyph);changed=true;}if(Recent.Count>MK002Settings.RecentEmojiCount)Recent.RemoveRange(MK002Settings.RecentEmojiCount,Recent.Count-MK002Settings.RecentEmojiCount);if(changed)SaveState();}internal void ToggleReaction(CaprichatMessage message,string emoji){if(message==null||string.IsNullOrEmpty(emoji))return;List<CaprichatReaction>list;if(!Reactions.TryGetValue(message.Id,out list))Reactions[message.Id]=list=new Li